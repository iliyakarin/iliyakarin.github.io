---
import { Image } from "astro:assets";

interface Props {
  logo?: any;
  altText: string;
  title: string;
  date: string;
  company: string;
  bullets: string[];
  tags: string[];
}

const { logo, altText, title, date, company, bullets, tags } = Astro.props;
---

<div class="relative pl-10 sm:pl-14">
    <span
        class="absolute -left-6 sm:-left-7 top-4 flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 bg-slate-900 rounded-full ring-4 ring-slate-900 overflow-hidden border border-gray-700 shadow-lg"
    >
        {logo ? (
            <Image
                src={logo}
                alt={altText}
                class="w-8 h-8 sm:w-10 sm:h-10 object-contain bg-white rounded-full p-1"
            />
        ) : (
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
        )}
    </span>
    <div
        class="p-6 bg-slate-800 rounded-lg border border-gray-700 shadow-md"
    >
        <div
            class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2"
        >
            <h3 class="text-xl sm:text-2xl font-bold text-white">
                {title}
            </h3>
            <span
                class="bg-blue-950 text-blue-300 border border-blue-800/80 text-xs font-semibold px-2.5 py-0.5 rounded whitespace-nowrap"
                >{date}</span
            >
        </div>
        <p class="text-base sm:text-lg font-semibold text-gray-300 mb-2">
            {company}
        </p>
        <ul class="list-disc list-inside text-gray-400 space-y-2 mb-4 text-sm sm:text-base">
            {bullets.map((bullet) => (
                <li set:html={bullet}></li>
            ))}
        </ul>
        <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-blue-900/60 text-blue-300 border border-blue-800/60">
                    {tag}
                </span>
            ))}
        </div>
    </div>
</div>
