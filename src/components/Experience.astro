---
import ExperienceItem from "./ExperienceItem.astro";
import inventLogo from "../assets/invent-logo.webp";
import vtbLogo from "../assets/vtb-bank-logo.png";
import nokiaLogo from "../assets/nokia-logo.png";
import gazpromLogo from "../assets/gazprom-logo.svg";
---

<section id="experience" class="bg-slate-900 py-20 border-b border-gray-800">
    <div class="py-8 px-4 mx-auto max-w-screen-xl lg:px-6">
        <div class="mx-auto max-w-screen-md text-center mb-16">
            <span class="text-xs font-semibold uppercase tracking-wider text-blue-400 bg-blue-950/80 border border-blue-800/60 px-3 py-1 rounded-full">
                Track Record & Background
            </span>
            <h2
                class="mt-4 mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold text-white"
            >
                15+ Years of Battle-Tested Authority
            </h2>
            <p class="font-normal text-gray-300 sm:text-lg">
                Direct executive and engineering leadership across high-load banking, regulated FinTech, telecom, and industrial infrastructure.
            </p>
        </div>

        <div class="relative border-l border-gray-700 ml-4 md:ml-8 space-y-12 max-w-4xl mx-auto">
            <!-- Invent -->
            <ExperienceItem
                logo={inventLogo}
                altText="Invent Logo"
                title="Head of Infrastructure, Security, & AI Strategy"
                date="Oct 2022 - Present"
                company="Invent (Austin, TX)"
                bullets={[
                    "Lead infrastructure, security, and AI strategy for cloud-native platforms serving regulated fintech institutions globally.",
                    "Designed a <strong>private AI platform</strong> on bare-metal GPU clusters (CozyStack, K8s), enabling compliant LLM inference and RAG pipelines.",
                    "Deployed open-weight models (GPT-OSS-120B, QWEN, Llama) via <strong>Kubeflow</strong> for strict data-sovereignty requirements.",
                    "Shipped <strong>internal AI products</strong>: on-prem coding agent, client-facing financial chat (RAG), MR reviewer, and log analyzer.",
                    "Achieved <strong>64%+ annual cloud savings</strong> through strategic rightsizing and architecture redesign."
                ]}
                tags={["Private AI", "LLM Inference", "RAG", "Kubernetes", "SOC2"]}
            />

            <!-- Innotech (VTB Bank) -->
            <ExperienceItem
                logo={vtbLogo}
                altText="VTB Bank Logo"
                title="Senior DevOps Manager"
                date="Aug 2020 - Oct 2022"
                company="Innotech / VTB Bank"
                bullets={[
                    "Led DevOps for a division of <strong>550+ engineers</strong> at a bank with <strong>$460B+ annual turnover</strong>.",
                    "Reduced deployment time from hours to minutes using automated Teamcity with Kotlin DSL auto generated pipelines.",
                    "Implemented production-grade <strong>OpenShift</strong> and microservices infrastructure.",
                    "Spearheaded observability transformation with Prometheus, Grafana, and ELK."
                ]}
                tags={["OpenShift", "FinTech", "Terraform"]}
            />

            <!-- Nokia -->
            <ExperienceItem
                logo={nokiaLogo}
                altText="Nokia Logo"
                title="Principal SRE"
                date="Mar 2019 - Aug 2020"
                company="Nokia"
                bullets={[
                    "Led deployment of the <strong>Nokia IMPACT IoT platform</strong> for large enterprise and telecom clients.",
                    "Designed high-availability infrastructure for geo-distributed environments.",
                    "Optimized platform scalability for <strong>millions of connected devices</strong>.",
                    "Automated lifecycle management using Ansible and Python."
                ]}
                tags={["IoT", "High Availability", "Python"]}
            />

            <!-- Gazprom -->
            <ExperienceItem
                logo={gazpromLogo}
                altText="Gazprom Logo"
                title="Lead DevOps Engineer"
                date="Jun 2015 - Mar 2019"
                company="Gazprom"
                bullets={[
                    "Re-architected enterprise infrastructure and implemented a 3-2-1 backup strategy for critical data clusters.",
                    "World's first integration of <strong>PureStorage NVMe</strong> via 10Gb iSCSI with VMware vSphere.",
                    "Deployed <strong>Thin Client</strong> terminal solutions to create highly secure, cost-effective workspaces.",
                    "Implemented complete workspace control and audit solutions for <strong>government compliance</strong> in the energy sector."
                ]}
                tags={["PureStorage NVMe", "VMware", "Governance"]}
            />

            <!-- Demetra IoT & Prior Enterprise IT -->
            <ExperienceItem
                altText="Industrial IoT Systems"
                title="Lead Infrastructure Architect"
                date="Jan 2012 - May 2015"
                company="Demetra IoT & Industrial Automation"
                bullets={[
                    "Engineered telemetry ingestion pipelines for distributed Industrial IoT sensors.",
                    "Designed fault-tolerant SCADA-adjacent gateway infrastructure with strict latency thresholds.",
                    "Implemented bare-metal server provisioning and high-availability clustered storage."
                ]}
                tags={["Industrial IoT", "Bare Metal", "Telemetry", "High Availability"]}
            />

            <!-- Education -->
            <div class="ml-6 md:ml-12 relative">
                <span
                    class="absolute flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-purple-950 rounded-full -left-8 sm:-left-10 ring-8 ring-slate-900 border border-purple-800"
                >
                    <svg
                        class="w-6 h-6 text-purple-300"
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M10 0a10 10 0 1 0 10 10A10.011 10.011 0 0 0 10 0Zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 13a8.949 8.949 0 0 1-4.951-1.488A3.987 3.987 0 0 1 9 13h2a3.987 3.987 0 0 1 3.951 3.512A8.949 8.949 0 0 1 10 18Z"
                        ></path>
                    </svg>
                </span>
                <div
                    class="p-6 bg-slate-800 rounded-lg border border-gray-700 shadow-md"
                >
                    <div
                        class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-2"
                    >
                        <h3 class="text-xl font-bold text-white">
                            Master's Degree in Computer Science
                        </h3>
                        <span
                            class="bg-purple-950 text-purple-300 border border-purple-800 text-xs font-semibold px-2.5 py-0.5 rounded mt-2 sm:mt-0"
                            >2005 - 2011</span
                        >
                    </div>
                    <p class="text-gray-400">
                        MATI (Russian State Technological University)
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
