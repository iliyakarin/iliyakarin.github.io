---
import Icon from "./Icon.astro";

interface Props {
    title: string;
    subtitle?: string;
    target?: string;
    price: string;
    description: string;
    features: string[];
    ctaText?: string;
    ctaHref?: string;
    isPopular?: boolean;
}

const {
    title,
    subtitle,
    target,
    price,
    description,
    features,
    ctaText = "Get Started",
    ctaHref = "#contact",
    isPopular = false,
} = Astro.props;
---

<div
    class={`flex flex-col p-6 sm:p-8 mx-auto w-full text-left rounded-xl border bg-slate-900 transition-all duration-200 justify-between relative ${
        isPopular
            ? "border-blue-500 shadow-xl shadow-blue-950/40 ring-1 ring-blue-500"
            : "border-gray-800 hover:border-gray-700 shadow-lg"
    }`}
>
    {
        isPopular && (
            <div class="absolute -top-3 right-6 bg-blue-600 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow">
                POPULAR
            </div>
        )
    }

    <div>
        <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-400 bg-blue-950/80 px-2.5 py-1 rounded border border-blue-800/60 inline-block mb-3">
                {price}
            </span>
            <h3 class="text-2xl font-extrabold text-white leading-snug">
                {title}
            </h3>
            {subtitle && <p class="text-sm text-gray-400 mt-1">{subtitle}</p>}
        </div>

        {
            target && (
                <div class="mb-4 p-3 rounded-lg bg-slate-800/60 border border-gray-800">
                    <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">
                        Best For
                    </span>
                    <p class="text-sm text-gray-300 leading-snug">
                        {target}
                    </p>
                </div>
            )
        }

        <p class="text-sm text-gray-400 mb-6 leading-relaxed">
            {description}
        </p>

        <div class="mb-4 text-xs font-bold uppercase tracking-wider text-gray-400">
            Key Deliverables
        </div>
        <ul role="list" class="mb-8 space-y-3">
            {
                features.map((feature) => (
                    <li class="flex items-start space-x-3 text-sm text-gray-300 leading-snug">
                        <Icon
                            name="checkmark"
                            class="flex-shrink-0 w-4 h-4 text-blue-400 mt-0.5"
                        />
                        <span>{feature}</span>
                    </li>
                ))
            }
        </ul>
    </div>

    <a
        href={ctaHref}
        class={`w-full text-center py-3 px-5 text-sm font-semibold rounded-lg transition-colors shadow-sm block mt-4 ${
            isPopular
                ? "text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-800"
                : "text-white bg-slate-800 hover:bg-slate-700 border border-gray-700 focus:ring-4 focus:ring-gray-800"
        }`}
    >
        {ctaText}
    </a>
</div>
