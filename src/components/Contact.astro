---
import SocialIcon from "./SocialIcon.astro";

const socialLinks = [
    {
        name: "WhatsApp",
        href: "https://wa.me/66832280608",
        icon: "whatsapp",
        color: "bg-[#25D366]",
        hoverColor: "hover:bg-[#20bd5a]",
    },
    {
        name: "Telegram",
        href: "https://t.me/iliyakarin",
        icon: "telegram",
        color: "bg-[#0088cc]",
        hoverColor: "hover:bg-[#0077b5]",
    },
] as const;

const buttonBaseClass =
    "flex items-center justify-center w-full sm:w-auto px-6 py-3 text-base font-medium text-white rounded-lg transition-colors shadow-lg";
---

<section id="contact" class="bg-slate-950 py-20 border-b border-gray-800">
    <div class="py-8 px-4 mx-auto max-w-screen-md">
        <div class="text-center mb-12">
            <span class="text-xs font-semibold uppercase tracking-wider text-blue-400 bg-blue-950/80 border border-blue-800/60 px-3 py-1 rounded-full">
                Direct Contact
            </span>
            <h2
                class="mt-4 mb-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
            >
                Let's Discuss Your Architecture
            </h2>
            <p class="font-normal text-gray-300 sm:text-lg max-w-xl mx-auto leading-relaxed">
                Inviting founders, CTOs, and VCs in Austin, TX and across the US to discuss cloud OpEx reduction, sovereign AI deployments, or fractional technical leadership.
            </p>
        </div>

        <div class="mb-14">
            <div class="text-center mb-6">
                <h3 class="text-xl font-bold text-white mb-2">
                    Book a 20-Min Architecture Discovery Call
                </h3>
                <p class="text-sm text-gray-400 max-w-lg mx-auto">
                    Select a time on the calendar below for a focused, zero-fluff technical discovery session.
                </p>
            </div>
            <!-- Calendly inline widget begin -->
            <div
                class="calendly-inline-widget rounded-xl overflow-hidden shadow-2xl border border-slate-700 min-w-[320px] h-[950px]"
                data-url="https://calendly.com/iliyakarin-it/meeting-with-iliya?hide_landing_page_details=1&hide_gdpr_banner=1&background_color=0f172a&text_color=ffffff&primary_color=3b82f6"
            >
            </div>
            <script src="/scripts/calendly-observer.js" defer></script>
            <!-- Calendly inline widget end -->
        </div>

        <div class="relative flex py-5 items-center mb-8">
            <div class="flex-grow border-t border-slate-800"></div>
            <span
                class="flex-shrink mx-4 text-gray-500 text-xs font-semibold uppercase tracking-wider"
                >Direct Messaging & LinkedIn</span
            >
            <div class="flex-grow border-t border-slate-800"></div>
        </div>

        <div
            class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-12"
        >
            <a
                href="https://www.linkedin.com/in/iliya-karin"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-full sm:w-auto px-6 py-3 text-base font-medium text-white rounded-lg bg-[#0077b5] hover:bg-[#006396] transition-colors shadow-lg"
            >
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
                LinkedIn Profile
            </a>
            {
                socialLinks.map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`${buttonBaseClass} ${link.color} ${link.hoverColor}`}
                    >
                        <SocialIcon icon={link.icon} class="w-6 h-6 mr-2" />
                        {link.name}
                    </a>
                ))
            }
        </div>

        <div class="relative flex py-5 items-center mb-8">
            <div class="flex-grow border-t border-slate-800"></div>
            <span
                class="flex-shrink mx-4 text-gray-500 text-xs font-semibold uppercase tracking-wider"
                >Direct Email Inquiry</span
            >
            <div class="flex-grow border-t border-slate-800"></div>
        </div>

        <form
            action="https://formspree.io/f/mojjeokl"
            method="POST"
            class="space-y-6 bg-slate-900 border border-gray-800 p-6 sm:p-8 rounded-xl shadow-lg"
        >
            <div>
                <label
                    for="email"
                    class="block mb-2 text-sm font-medium text-gray-300"
                    >Work Email</label
                >
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="shadow-sm bg-slate-800 border border-gray-700 text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-3"
                    placeholder="name@company.com"
                    maxlength="254"
                    required
                />
            </div>
            <div>
                <label
                    for="subject"
                    class="block mb-2 text-sm font-medium text-gray-300"
                    >Subject / Engagement Type</label
                >
                <input
                    type="text"
                    id="subject"
                    name="subject"
                    class="block p-3 w-full text-sm text-white bg-slate-800 rounded-lg border border-gray-700 shadow-sm focus:ring-blue-500 focus:border-blue-500"
                    placeholder="e.g. Cloud OpEx Audit, Sovereign AI, or Fractional CTO"
                    maxlength="200"
                    required
                />
            </div>
            <div>
                <label
                    for="message"
                    class="block mb-2 text-sm font-medium text-gray-300"
                    >Current Stack & Bottlenecks</label
                >
                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    class="block p-3 w-full text-sm text-white bg-slate-800 rounded-lg shadow-sm border border-gray-700 focus:ring-blue-500 focus:border-blue-500"
                    placeholder="Briefly describe your company stage, cloud setup, and current challenges..."
                    maxlength="5000"></textarea>
            </div>
            <button
                type="submit"
                class="w-full sm:w-auto py-3 px-6 text-sm font-semibold text-center text-white rounded-lg bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-800 transition-colors shadow-sm"
                >Send Inquiry</button
            >
        </form>
    </div>
</section>
