---
const CALENDLY_URL = "#contact";
---

<section id="home" class="relative bg-slate-900 pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/25 via-slate-900/80 to-slate-900"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-slate-700 to-transparent"
        >
        </div>
    </div>
    <div
        class="relative px-4 mx-auto max-w-screen-xl text-center lg:px-12"
    >
        <div
            class="inline-flex items-center py-1.5 px-4 mb-8 text-xs font-semibold uppercase tracking-wider text-blue-400 bg-blue-950/70 border border-blue-800/60 rounded-full"
            role="status"
        >
            FRACTIONAL CTO | HEAD OF PLATFORM & AI INFRASTRUCTURE
        </div>
        <h1
            class="mb-6 text-4xl font-extrabold tracking-tight leading-tight text-white md:text-5xl lg:text-6xl max-w-5xl mx-auto"
        >
            Enterprise-Grade Platform and Sovereign AI Infrastructure Without the Full-Time Executive Overhead.
        </h1>
        <p
            class="mb-10 text-lg font-normal text-gray-300 lg:text-xl max-w-3xl mx-auto leading-relaxed"
        >
            I help Seed to Series B startups and established enterprises slash cloud OpEx by up to 64%, deploy private On-Premise AI, and pass strict SOC2 Type II audits on the first try. I step in as a playing coach who actually logs into the terminal and fixes the bottlenecks.
        </p>
        <div
            class="flex flex-col sm:flex-row justify-center items-center gap-4"
        >
            <a
                href={CALENDLY_URL}
                class="inline-flex justify-center items-center py-4 px-6 text-base font-semibold text-center text-white rounded-lg bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-900 transition-colors shadow-lg shadow-blue-900/30 w-full sm:w-auto"
            >
                Book a 20-Min Architecture Discovery Call
                <svg
                    class="ml-2 w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                    ></path>
                </svg>
            </a>
            <a
                href="#track-record"
                class="inline-flex justify-center items-center py-4 px-6 text-base font-semibold text-center text-gray-200 rounded-lg border border-gray-700 hover:bg-gray-800 focus:ring-4 focus:ring-gray-700 transition-colors w-full sm:w-auto"
            >
                View Proven Track Record
            </a>
        </div>
    </div>
</section>
