---
import { Image } from "astro:assets";
import iliyaImage from "../assets/iliya.jpg";
import nokiaLogo from "../assets/nokia-logo.png";
import gazpromLogo from "../assets/gazprom-logo.svg";
import vtbLogo from "../assets/vtb-bank-logo.png";
import inventLogo from "../assets/invent-logo.webp";

const partnerLogos = [
    { src: nokiaLogo, alt: "Nokia" },
    { src: gazpromLogo, alt: "Gazprom" },
    { src: vtbLogo, alt: "VTB Bank" },
    { src: inventLogo, alt: "Invent" }
];

const logoClass = "h-10 sm:h-12 w-auto grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300";

const pillars = [
    {
        title: "Cloud Repatriation & Bare Metal",
        tag: "Capital Efficiency",
        description: "Escaping hyperscaler lock-in across AWS, GCP, Azure, and Nebius Cloud when unit economics demand dedicated silicon. Bringing stable workloads to bare metal cuts recurring cloud bills by over 60% without sacrificing throughput."
    },
    {
        title: "Pragmatic Edge & Local AI",
        tag: "Data Sovereignty",
        description: "Deploying specialized 8B-30B open-weight models that outperform bloated general APIs on narrow enterprise tasks at a fraction of the cost. Local inference with vLLM, Ollama, and read-only MCP server guardrails."
    },
    {
        title: "Zero-Failure FinTech Standard",
        tag: "Audit Readiness",
        description: "Bringing 15+ years of battle-tested practices from Nokia, Wealth Management, Regulated FinTech, and Industrial IoT (Demetra IoT) to growing tech teams. Deterministic CI/CD pipelines, strict sandbox isolation, and first-pass SOC2 Type II compliance."
    }
];
---

<section id="expertise" class="bg-slate-950 py-20 border-b border-gray-800">
    <div class="py-8 px-4 mx-auto max-w-screen-xl lg:px-6">
        <div class="max-w-3xl mx-auto text-center mb-16">
            <span class="text-xs font-semibold uppercase tracking-wider text-blue-400 bg-blue-950/80 border border-blue-800/60 px-3 py-1 rounded-full">
                Technical Philosophy & Approach
            </span>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                Why Hire a Playing Coach
            </h2>
            <p class="mt-3 text-base sm:text-lg text-gray-300">
                Most advisors produce theoretical slide decks and disappear before deployment. I log into the terminal, resolve the architecture bottlenecks, and train your team to maintain operational velocity.
            </p>
        </div>

        <!-- 3 Core Philosophy Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
            {
                pillars.map((pillar) => (
                    <div class="bg-slate-900 border border-gray-800 p-8 rounded-xl hover:border-blue-700/60 transition-colors flex flex-col justify-between">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-blue-400 bg-blue-950/80 px-2.5 py-1 rounded border border-blue-800/60 inline-block mb-4">
                                {pillar.tag}
                            </span>
                            <h3 class="text-xl font-bold text-white mb-3">
                                {pillar.title}
                            </h3>
                            <p class="text-sm text-gray-300 leading-relaxed">
                                {pillar.description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Executive Authority & Profile Block -->
        <div class="bg-slate-900/90 border border-gray-800 rounded-2xl p-8 sm:p-12">
            <div class="grid gap-10 lg:grid-cols-12 items-center">
                <div class="lg:col-span-5 flex justify-center">
                    <div class="relative w-full max-w-sm">
                        <div class="overflow-hidden rounded-xl border-2 border-slate-700 shadow-2xl">
                            <Image
                                src={iliyaImage}
                                alt="Iliya Karin - DevSecOps Expert"
                                class="w-full h-auto object-cover"
                            />
                        </div>
                        <div class="absolute -bottom-4 -right-4 w-20 h-20 bg-blue-600/20 rounded-xl -z-10 border border-blue-500/30"></div>
                        <div class="absolute -top-4 -left-4 w-20 h-20 bg-purple-600/20 rounded-full -z-10 border border-purple-500/30"></div>
                    </div>
                </div>

                <div class="lg:col-span-7">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-950/80 border border-purple-800/60 text-purple-300 text-xs font-semibold mb-4">
                        <span>EB-1A Extraordinary Ability Distinction</span>
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
                        15+ Years of Deterministic Systems Engineering
                    </h3>
                    <p class="text-gray-300 text-base leading-relaxed mb-6">
                        Recognized by the US Government under the EB-1A classification for Extraordinary Ability in Cloud Security, AI Infrastructure, and Scalable Platform Architecture. I partner with founders, venture capital partners, and enterprise executives who need uncompromised technical rigor.
                    </p>

                    <div class="mb-8">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">
                            Trusted By Leadership at Regulated Organizations
                        </h4>
                        <p class="text-sm text-gray-300 leading-relaxed">
                            Delivered systems and architectural reviews for teams connected to <strong class="text-white">Goldman Sachs</strong>, <strong class="text-white">Alliance Insurance</strong>, <strong class="text-white">Cambridge Investment Research</strong>, and <strong class="text-white">Douglas Elliman Realty</strong>.
                        </p>
                    </div>

                    <div>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-4">
                            Enterprise Leadership Background
                        </h4>
                        <div class="flex flex-wrap items-center gap-8">
                            {
                                partnerLogos.map((logo) => (
                                    <Image
                                        src={logo.src}
                                        alt={logo.alt}
                                        class={logoClass}
                                    />
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
