---
const currentYear = new Date().getFullYear();
---

<footer class="p-6 bg-slate-950 md:p-10 border-t border-gray-800">
    <div class="mx-auto max-w-screen-xl text-center">
        <div class="flex flex-col items-center justify-center mb-6">
            <span class="text-xl font-bold tracking-tight text-white">
                Iliya Karin
            </span>
            <span class="text-xs font-semibold text-gray-400 mt-1">
                Fractional CTO | Head of Platform & AI Infrastructure | Austin, TX
            </span>
        </div>
        <p class="my-4 text-sm text-gray-400 max-w-md mx-auto leading-relaxed">
            Enterprise-grade cloud optimization, sovereign on-premise AI, and deterministic platform engineering for high-growth tech companies.
        </p>
        <ul class="flex flex-wrap justify-center items-center my-6 text-sm text-gray-300 gap-y-2">
            <li>
                <a href="#services" class="mr-6 hover:text-white transition-colors">Services</a>
            </li>
            <li>
                <a href="#track-record" class="mr-6 hover:text-white transition-colors">Track Record</a>
            </li>
            <li>
                <a href="#expertise" class="mr-6 hover:text-white transition-colors">Expertise</a>
            </li>
            <li>
                <a href="#experience" class="mr-6 hover:text-white transition-colors">Experience (CV)</a>
            </li>
            <li>
                <a
                    href="https://www.linkedin.com/in/iliya-karin"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mr-6 hover:text-white transition-colors"
                >LinkedIn</a>
            </li>
            <li>
                <a href="#contact" class="hover:text-white transition-colors">Contact</a>
            </li>
        </ul>
        <div class="text-xs text-gray-500">
            (c) {currentYear} Iliya Karin. All rights reserved.
        </div>
    </div>
</footer>
