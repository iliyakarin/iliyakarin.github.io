---
import { Image } from "astro:assets";
import linkedinLogo from "../assets/linkedin-logo.png";
import SocialIcon from "./SocialIcon.astro";

const navItems = [
    { label: "Services", href: "#services" },
    { label: "Track Record", href: "#track-record" },
    { label: "Expertise", href: "#expertise" },
    { label: "Experience (CV)", href: "#experience" },
];

const navLinkClasses =
    "nav-link block py-2 px-3 text-gray-300 rounded hover:bg-gray-800 md:hover:bg-transparent md:hover:text-blue-400 md:p-0 transition-colors";
---

<nav
    class="fixed w-full z-50 top-0 start-0 border-b border-gray-800 bg-slate-900/95 backdrop-blur-md"
>
    <div
        class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
        <a href="#" class="flex flex-col sm:flex-row sm:items-center sm:gap-3">
            <span class="text-xl font-bold tracking-tight text-white whitespace-nowrap">
                Iliya Karin
            </span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-blue-950/80 text-blue-400 border border-blue-800/60 mt-1 sm:mt-0 w-fit">
                Austin, TX | US & Global
            </span>
        </a>
        <div
            class="flex md:order-2 space-x-3 md:space-x-4 rtl:space-x-reverse items-center"
        >
            <a
                href="https://www.linkedin.com/in/iliya-karin/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:opacity-80 transition-opacity text-white"
                aria-label="LinkedIn"
            >
                <Image src={linkedinLogo} alt="LinkedIn" class="w-5 h-5" />
            </a>
            <a
                href="https://wa.me/66832280608"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:opacity-80 transition-opacity text-[#25D366]"
                aria-label="WhatsApp"
            >
                <SocialIcon icon="whatsapp" class="w-5 h-5" />
            </a>
            <a
                href="https://t.me/iliyakarin"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:opacity-80 transition-opacity text-[#0088cc]"
                aria-label="Telegram"
            >
                <SocialIcon icon="telegram" class="w-5 h-5" />
            </a>
            <a
                href="#contact"
                class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-800 font-semibold rounded-lg text-sm px-4 py-2 text-center transition-colors shadow-sm"
                >Book a Call</a
            >
            <button
                data-collapse-toggle="navbar-sticky"
                type="button"
                class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-400 rounded-lg md:hidden hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-600"
                aria-controls="navbar-sticky"
                aria-expanded="false"
            >
                <span class="sr-only">Open main menu</span>
                <svg
                    class="w-5 h-5"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 17 14"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 1h15M1 7h15M1 13h15"></path>
                </svg>
            </button>
        </div>
        <div
            class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
            id="navbar-sticky"
        >
            <ul
                class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-gray-800 rounded-lg md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0"
            >
                {
                    navItems.map((item) => (
                        <li>
                            <a href={item.href} class={navLinkClasses}>
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</nav>

<script src="/scripts/navigation.js" defer></script>
