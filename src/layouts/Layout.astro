---
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			http-equiv="Content-Security-Policy"
			content="default-src 'self'; script-src 'self' https://assets.calendly.com; style-src 'self' 'unsafe-inline'; frame-src https://calendly.com; img-src 'self' data:; connect-src 'self'; form-action https://formspree.io; object-src 'none'; base-uri 'self';"
		/>
		<title>Iliya Karin | Fractional CTO & AI Infrastructure | Austin, TX</title>
		<meta
			name="description"
			content="Fractional CTO and Head of Platform & AI Infrastructure for Seed to Series B startups. Slash cloud OpEx, deploy sovereign on-prem AI, and pass strict SOC2 audits."
		/>
	</head>
	<body class="bg-slate-900 text-white font-sans antialiased">
		<IconSprite />
		<slot />
	</body>
</html>
